// ── Render Functions ──
function renderTable(data){
  const tb=document.getElementById('tableBody');tb.innerHTML='';
  data.forEach(d=>{
    const c24=d.change24>=0?'up':'down',c7d=d.change7d>=0?'up':'down';
    const s24=d.change24>=0?'+':'',s7d=d.change7d>=0?'+':'';
    const fC=d.funding>=0?'pos':'neg',fS=d.funding>=0?'+':'';
    const pD=d.price>=1?'$'+d.price.toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2}):'$'+d.price.toFixed(6);
    const tr=document.createElement('tr');tr.dataset.tags=d.tags.join(',');
    tr.innerHTML=`<td class="rank">${d.rank}</td><td><div style="display:flex;align-items:center;gap:12px"><div class="asset-icon" style="background:${d.color}18;color:${d.color};border:1px solid ${d.color}30">${d.symbol.slice(0,2)}</div><div class="asset-info"><span class="asset-name">${d.name}</span><span class="asset-pair">${d.pair}</span></div></div></td><td class="right price">${pD}</td><td class="right"><span class="change ${c24}">${s24}${d.change24.toFixed(2)}%</span></td><td class="right"><span class="change ${c7d}">${s7d}${d.change7d.toFixed(2)}%</span></td><td class="right volume">$${d.vol}</td><td class="right" style="font-weight:600">$${d.mcap}</td><td class="center"><span class="funding ${fC}">${fS}${(d.funding*100).toFixed(3)}%</span></td><td class="center"><div class="oi-bar"><div class="oi-bar-fill"><div class="long" style="width:${d.longPct}%"></div></div><span class="oi-bar-label">$${d.oi}</span></div></td><td class="center" style="font-weight:700;color:${d.longPct>55?'var(--accent)':d.longPct<48?'var(--red)':'var(--text-dim)'}">${d.longPct}/${100-d.longPct}</td>`;
    tb.appendChild(tr);
  });
}

