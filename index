<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>CryptoScope — Top 30 Dashboard</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@300;400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #f0f2f7; --bg-panel: #ffffff; --bg-row: #f8f9fc; --bg-row-hover: #eef1f8;
    --border: #dde1ea; --accent: #0fa968; --accent-dim: #0fa96818;
    --red: #e53e51; --red-dim: #e53e5115; --yellow: #d4940a; --yellow-dim: #d4940a15;
    --blue: #2563eb; --blue-dim: #2563eb12; --orange: #e8740c; --purple: #7c3aed;
    --text: #1a1f2e; --text-dim: #5c6478; --text-muted: #9aa0b0;
    --shadow-sm: 0 1px 3px rgba(0,0,0,0.06); --shadow-md: 0 4px 12px rgba(0,0,0,0.08);
  }
  * { margin:0; padding:0; box-sizing:border-box; }
  body { background:var(--bg); color:var(--text); font-family:'JetBrains Mono',monospace; min-height:100vh; overflow-x:hidden; }
  .app { position:relative; z-index:1; max-width:1600px; margin:0 auto; padding:24px 28px 60px; }

  .header { display:flex; align-items:center; justify-content:space-between; padding:18px 28px 20px; border-bottom:1px solid var(--border); margin-bottom:28px; background:var(--bg-panel); border-radius:14px; box-shadow:var(--shadow-sm); }
  .logo-area { display:flex; align-items:center; gap:16px; }
  .logo-icon { width:44px; height:44px; background:linear-gradient(135deg,var(--accent),#2563eb); border-radius:11px; display:flex; align-items:center; justify-content:center; font-size:20px; font-weight:700; color:#fff; box-shadow:0 4px 14px rgba(15,169,104,0.3); }
  .logo-text { font-family:'Space Grotesk',sans-serif; font-size:26px; font-weight:700; letter-spacing:-0.5px; }
  .logo-text span { color:var(--accent); }
  .header-right { display:flex; align-items:center; gap:22px; }
  .live-dot { width:9px; height:9px; background:var(--accent); border-radius:50%; animation:pulse 2s infinite; }
  @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:0.3} }
  .header-time { font-size:13px; color:var(--text-dim); }
  .refresh-btn { background:var(--accent); border:none; color:#fff; padding:9px 20px; border-radius:8px; font-family:inherit; font-size:13px; font-weight:600; cursor:pointer; transition:all 0.2s; text-transform:uppercase; box-shadow:0 2px 8px rgba(15,169,104,0.25); }
  .refresh-btn:hover { background:#0c8f58; transform:translateY(-1px); }

  .stats-bar { display:grid; grid-template-columns:repeat(4,1fr); gap:16px; margin-bottom:28px; }
  .stat-card { background:var(--bg-panel); border:1px solid var(--border); border-radius:14px; padding:22px 24px; position:relative; overflow:hidden; box-shadow:var(--shadow-sm); opacity:0; animation:fadeUp 0.5s ease forwards; }
  .stat-card:nth-child(1){animation-delay:0.1s} .stat-card:nth-child(2){animation-delay:0.15s} .stat-card:nth-child(3){animation-delay:0.2s} .stat-card:nth-child(4){animation-delay:0.25s}
  .stat-card::before { content:''; position:absolute; top:0; left:0; right:0; height:3px; }
  .stat-card:nth-child(1)::before{background:var(--accent)} .stat-card:nth-child(2)::before{background:var(--blue)} .stat-card:nth-child(3)::before{background:var(--yellow)} .stat-card:nth-child(4)::before{background:var(--purple)}
  .stat-label { font-size:12px; color:var(--text-dim); text-transform:uppercase; letter-spacing:1px; margin-bottom:8px; }
  .stat-value { font-family:'Space Grotesk',sans-serif; font-size:28px; font-weight:700; }
  .stat-sub { font-size:13px; margin-top:5px; }
  .stat-sub.up { color:var(--accent); } .stat-sub.down { color:var(--red); }

  .section-title { display:flex; align-items:center; gap:12px; margin:34px 0 16px; font-family:'Space Grotesk',sans-serif; font-size:20px; font-weight:700; }
  .section-title .icon { width:32px; height:32px; border-radius:8px; display:flex; align-items:center; justify-content:center; font-size:16px; }
  .section-title .badge { font-size:11px; font-family:'JetBrains Mono',monospace; padding:3px 10px; border-radius:6px; font-weight:600; }

  .tab-bar { display:flex; gap:4px; margin-bottom:16px; background:var(--bg-panel); border-radius:10px; padding:5px; border:1px solid var(--border); width:fit-content; box-shadow:var(--shadow-sm); }
  .tab-btn { padding:9px 22px; border:none; background:transparent; color:var(--text-dim); font-family:inherit; font-size:14px; font-weight:500; border-radius:8px; cursor:pointer; transition:all 0.2s; }
  .tab-btn.active { background:var(--accent); color:#fff; box-shadow:0 2px 8px rgba(15,169,104,0.25); }
  .tab-btn:hover:not(.active) { background:#e8ecf4; color:var(--text); }

  .table-wrap { background:var(--bg-panel); border:1px solid var(--border); border-radius:16px; overflow:hidden; box-shadow:var(--shadow-sm); opacity:0; animation:fadeUp 0.6s ease forwards; animation-delay:0.3s; }
  .table-header { display:flex; align-items:center; justify-content:space-between; padding:16px 22px; border-bottom:1px solid var(--border); background:#fafbfd; }
  .table-header-left { font-size:15px; font-weight:600; }
  .search-box { background:var(--bg); border:1px solid var(--border); border-radius:8px; padding:9px 14px; color:var(--text); font-family:inherit; font-size:13px; width:230px; outline:none; transition:all 0.2s; }
  .search-box:focus { border-color:var(--accent); box-shadow:0 0 0 3px rgba(15,169,104,0.1); }
  table { width:100%; border-collapse:collapse; }
  thead th { padding:13px 16px; font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:0.8px; color:var(--text-dim); text-align:left; border-bottom:2px solid var(--border); background:#f6f7fb; position:sticky; top:0; cursor:pointer; user-select:none; white-space:nowrap; }
  thead th:hover { color:var(--accent); }
  thead th.right, td.right { text-align:right; } thead th.center, td.center { text-align:center; }
  tbody tr { border-bottom:1px solid #eef0f5; transition:background 0.15s; }
  tbody tr:hover { background:var(--bg-row-hover); }
  td { padding:13px 16px; font-size:14px; white-space:nowrap; }
  td.rank { color:var(--text-muted); font-weight:600; width:44px; }
  .asset-icon { width:34px; height:34px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:12px; font-weight:700; flex-shrink:0; }
  .asset-info { display:flex; flex-direction:column; }
  .asset-name { font-weight:600; font-size:15px; }
  .asset-pair { font-size:11px; color:var(--text-dim); }
  .price { font-weight:600; }
  .change { font-weight:700; padding:4px 10px; border-radius:6px; font-size:13px; display:inline-block; }
  .change.up { color:#0a8f56; background:#e6f9f0; }
  .change.down { color:#c43040; background:#fde8eb; }
  .volume { color:var(--text-dim); }
  .funding { font-weight:600; }
  .funding.pos { color:var(--accent); } .funding.neg { color:var(--red); }
  .oi-bar { display:flex; align-items:center; gap:10px; }
  .oi-bar-fill { height:6px; border-radius:3px; overflow:hidden; width:70px; background:#fde8eb; position:relative; }
  .oi-bar-fill .long { position:absolute; left:0; top:0; bottom:0; background:var(--accent); border-radius:3px; }
  .oi-bar-label { font-size:11px; color:var(--text-dim); min-width:38px; }
  .table-scroll { max-height:640px; overflow-y:auto; }

  .exchange-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:12px; opacity:0; animation:fadeUp 0.6s ease forwards; animation-delay:0.35s; }
  .exchange-card { background:var(--bg-panel); border:1px solid var(--border); border-radius:14px; padding:20px 22px; display:grid; grid-template-columns:44px 1fr auto; align-items:center; gap:16px; transition:all 0.2s; box-shadow:var(--shadow-sm); }
  .exchange-card:hover { box-shadow:var(--shadow-md); transform:translateY(-1px); }
  .ex-rank { width:38px; height:38px; border-radius:10px; background:var(--bg); display:flex; align-items:center; justify-content:center; font-size:14px; font-weight:700; color:var(--text-dim); border:1px solid var(--border); }
  .ex-info { min-width:0; }
  .ex-top { display:flex; align-items:center; gap:10px; margin-bottom:10px; }
  .ex-logo { width:30px; height:30px; border-radius:8px; display:flex; align-items:center; justify-content:center; font-size:11px; font-weight:700; flex-shrink:0; }
  .ex-name { font-weight:600; font-size:15px; }
  .ex-type { font-size:11px; color:var(--text-dim); margin-left:8px; font-weight:600; }
  .ex-bar-container { display:flex; align-items:center; gap:12px; }
  .ex-bar { flex:1; height:10px; border-radius:5px; overflow:hidden; background:#eef0f5; position:relative; }
  .ex-bar .spot-fill { position:absolute; left:0; top:0; bottom:0; background:linear-gradient(90deg,var(--accent),#34d399); border-radius:5px 0 0 5px; }
  .ex-bar .futures-fill { position:absolute; top:0; bottom:0; background:linear-gradient(90deg,var(--blue),#818cf8); border-radius:0 5px 5px 0; }
  .ex-legend { display:flex; gap:14px; font-size:11px; }
  .ex-legend span { display:flex; align-items:center; gap:5px; }
  .ex-legend .dot { width:8px; height:8px; border-radius:50%; }
  .ex-vol { text-align:right; min-width:110px; }
  .ex-vol-total { font-family:'Space Grotesk',sans-serif; font-size:18px; font-weight:700; }
  .ex-vol-label { font-size:11px; color:var(--text-dim); }
  .ex-vol-breakdown { font-size:11px; color:var(--text-muted); margin-top:3px; }

  .events-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:16px; opacity:0; animation:fadeUp 0.6s ease forwards; animation-delay:0.4s; }
  .event-card { background:var(--bg-panel); border:1px solid var(--border); border-radius:14px; padding:24px; transition:all 0.25s; position:relative; overflow:hidden; cursor:pointer; box-shadow:var(--shadow-sm); }
  .event-card:hover { border-color:var(--accent); transform:translateY(-2px); box-shadow:0 6px 24px rgba(15,169,104,0.15); }
  .event-card .tag { display:inline-block; font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:0.8px; padding:4px 12px; border-radius:6px; margin-bottom:14px; }
  .tag.hot { background:#fde8eb; color:var(--red); }
  .tag.news { background:#eff4ff; color:var(--blue); }
  .tag.upgrade { background:#e6f9f0; color:var(--accent); }
  .tag.partnership { background:#fef7e6; color:var(--yellow); }
  .tag.regulation { background:#f3edff; color:var(--purple); }
  .event-card h4 { font-family:'Space Grotesk',sans-serif; font-size:17px; font-weight:700; margin-bottom:10px; line-height:1.45; }
  .event-card p { font-size:13px; color:var(--text-dim); line-height:1.7; }
  .event-meta { display:flex; align-items:center; gap:14px; margin-top:14px; font-size:12px; color:var(--text-muted); }
  .event-meta .source { color:var(--accent); font-weight:600; }
  .event-card .click-hint { position:absolute; bottom:14px; right:16px; font-size:11px; color:var(--text-muted); opacity:0; transition:opacity 0.2s; }
  .event-card:hover .click-hint { opacity:1; }

  /* ── Incidents ── */
  .incidents-list { display:flex; flex-direction:column; gap:12px; opacity:0; animation:fadeUp 0.6s ease forwards; animation-delay:0.5s; }
  .incident-row {
    display:grid; grid-template-columns:90px 1fr 140px 120px 110px; align-items:center; gap:16px;
    background:var(--bg-panel); border:1px solid var(--border); border-radius:12px;
    padding:18px 22px; transition:all 0.2s; box-shadow:var(--shadow-sm); cursor:pointer;
  }
  .incident-row:hover { box-shadow:var(--shadow-md); transform:translateY(-1px); border-color:var(--red); }
  .incident-row .click-hint2 { position:absolute; right:16px; bottom:8px; font-size:10px; color:var(--text-muted); opacity:0; transition:opacity 0.2s; }
  .incident-row { position:relative; }
  .incident-row:hover .click-hint2 { opacity:1; }
  .severity { font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:0.8px; padding:5px 12px; border-radius:6px; text-align:center; }
  .severity.critical { background:#fde8eb; color:var(--red); }
  .severity.high { background:#fff3e0; color:var(--orange); }
  .severity.medium { background:#fef7e6; color:var(--yellow); }
  .severity.low { background:#eff4ff; color:var(--blue); }
  .incident-info h5 { font-size:15px; font-weight:600; margin-bottom:4px; }
  .incident-info p { font-size:13px; color:var(--text-dim); }
  .incident-loss { font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:16px; color:var(--red); text-align:right; }
  .incident-chain { font-size:13px; color:var(--text-dim); text-align:center; }
  .incident-time { font-size:13px; color:var(--text-muted); text-align:right; }

  /* ── Shared Modal ── */
  .modal-overlay { position:fixed; inset:0; z-index:10000; background:rgba(15,18,30,0.45); backdrop-filter:blur(8px); display:none; align-items:center; justify-content:center; opacity:0; transition:opacity 0.3s; }
  .modal-overlay.visible { display:flex; opacity:1; }
  .modal-panel { background:var(--bg-panel); border:1px solid var(--border); border-radius:20px; width:90%; max-width:820px; max-height:85vh; overflow-y:auto; transform:translateY(20px) scale(0.97); transition:transform 0.35s cubic-bezier(0.16,1,0.3,1); box-shadow:0 30px 90px rgba(0,0,0,0.18); }
  .modal-overlay.visible .modal-panel { transform:translateY(0) scale(1); }
  .modal-header { padding:28px 32px 20px; border-bottom:1px solid var(--border); display:flex; align-items:flex-start; justify-content:space-between; gap:18px; }
  .modal-header .tag { font-size:11px; }
  .modal-title { font-family:'Space Grotesk',sans-serif; font-size:22px; font-weight:700; line-height:1.35; margin-top:10px; }
  .modal-close { width:40px; height:40px; border-radius:10px; border:1px solid var(--border); background:var(--bg); color:var(--text-dim); font-size:20px; cursor:pointer; transition:all 0.2s; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
  .modal-close:hover { border-color:var(--red); color:var(--red); background:#fde8eb; }
  .modal-body { padding:28px 32px 32px; }
  .modal-section { margin-bottom:26px; }
  .modal-section:last-child { margin-bottom:0; }
  .modal-section-title { font-size:12px; font-weight:700; text-transform:uppercase; letter-spacing:1px; color:var(--accent); margin-bottom:12px; display:flex; align-items:center; gap:8px; }
  .modal-section-title::before { content:''; width:3px; height:14px; background:var(--accent); border-radius:2px; }
  .modal-section-title.red { color:var(--red); }
  .modal-section-title.red::before { background:var(--red); }
  .modal-section-title.orange { color:var(--orange); }
  .modal-section-title.orange::before { background:var(--orange); }
  .modal-section-title.blue { color:var(--blue); }
  .modal-section-title.blue::before { background:var(--blue); }
  .modal-text { font-size:15px; line-height:1.85; color:var(--text); }
  .modal-text a { color:var(--accent); text-decoration:none; border-bottom:1px solid var(--accent-dim); font-weight:500; }
  .modal-text a:hover { border-bottom-color:var(--accent); }
  .modal-meta-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:12px; margin-top:8px; }
  .modal-meta-item { background:var(--bg); border:1px solid var(--border); border-radius:10px; padding:16px; }
  .modal-meta-item .label { font-size:11px; color:var(--text-dim); text-transform:uppercase; letter-spacing:0.5px; margin-bottom:5px; }
  .modal-meta-item .value { font-family:'Space Grotesk',sans-serif; font-size:17px; font-weight:700; }
  .modal-timeline { position:relative; padding-left:24px; }
  .modal-timeline::before { content:''; position:absolute; left:6px; top:4px; bottom:4px; width:2px; background:var(--border); border-radius:1px; }
  .timeline-item { position:relative; margin-bottom:16px; }
  .timeline-item:last-child { margin-bottom:0; }
  .timeline-item::before { content:''; position:absolute; left:-21px; top:7px; width:10px; height:10px; border-radius:50%; border:2px solid var(--bg-panel); box-shadow:0 0 0 2px var(--accent-dim); }
  .timeline-item.green::before { background:var(--accent); }
  .timeline-item.red-dot::before { background:var(--red); box-shadow:0 0 0 2px var(--red-dim); }
  .timeline-item .tl-time { font-size:11px; color:var(--text-muted); margin-bottom:3px; }
  .timeline-item .tl-text { font-size:14px; line-height:1.55; }
  .modal-tags { display:flex; flex-wrap:wrap; gap:8px; margin-top:8px; }
  .modal-asset-tag { background:var(--bg); border:1px solid var(--border); border-radius:8px; padding:6px 14px; font-size:13px; font-weight:500; }
  .modal-impact { display:flex; gap:16px; margin-top:8px; flex-wrap:wrap; }
  .impact-item { flex:1; min-width:140px; background:var(--bg); border:1px solid var(--border); border-radius:10px; padding:16px; text-align:center; }
  .impact-item .impact-val { font-family:'Space Grotesk',sans-serif; font-size:20px; font-weight:700; }
  .impact-item .impact-val.up { color:var(--accent); }
  .impact-item .impact-val.down { color:var(--red); }
  .impact-item .impact-label { font-size:11px; color:var(--text-dim); margin-top:3px; }

  /* Incident modal specifics */
  .loss-breakdown-table { width:100%; border-collapse:collapse; margin-top:6px; }
  .loss-breakdown-table th { text-align:left; font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:0.5px; color:var(--text-dim); padding:8px 12px; border-bottom:2px solid var(--border); background:#f6f7fb; }
  .loss-breakdown-table td { padding:10px 12px; font-size:13px; border-bottom:1px solid #eef0f5; }
  .loss-breakdown-table tr:hover { background:var(--bg-row-hover); }
  .loss-amt { color:var(--red); font-weight:700; font-family:'Space Grotesk',sans-serif; }
  .cause-list { list-style:none; padding:0; }
  .cause-list li { padding:8px 0 8px 24px; font-size:14px; line-height:1.6; position:relative; border-bottom:1px solid #eef0f5; }
  .cause-list li:last-child { border-bottom:none; }
  .cause-list li::before { content:'→'; position:absolute; left:0; color:var(--red); font-weight:700; }
  .remediation-list { list-style:none; padding:0; }
  .remediation-list li { padding:8px 0 8px 24px; font-size:14px; line-height:1.6; position:relative; border-bottom:1px solid #eef0f5; }
  .remediation-list li:last-child { border-bottom:none; }
  .remediation-list li::before { content:'✓'; position:absolute; left:0; color:var(--accent); font-weight:700; }
  .status-badge { display:inline-block; font-size:11px; font-weight:700; padding:4px 12px; border-radius:6px; text-transform:uppercase; letter-spacing:0.5px; }
  .status-badge.ongoing { background:#fde8eb; color:var(--red); }
  .status-badge.mitigated { background:#fef7e6; color:var(--yellow); }
  .status-badge.resolved { background:#e6f9f0; color:var(--accent); }

  @keyframes fadeUp { from{opacity:0;transform:translateY(16px)} to{opacity:1;transform:translateY(0)} }
  ::-webkit-scrollbar { width:7px; }
  ::-webkit-scrollbar-track { background:var(--bg); }
  ::-webkit-scrollbar-thumb { background:#cdd3e0; border-radius:4px; }

  @media(max-width:1200px) {
    .stats-bar{grid-template-columns:repeat(2,1fr)} .events-grid{grid-template-columns:1fr} .exchange-grid{grid-template-columns:1fr}
    .incident-row{grid-template-columns:80px 1fr 110px 90px} .incident-chain{display:none} .modal-meta-grid{grid-template-columns:repeat(2,1fr)}
  }
  @media(max-width:768px) {
    .app{padding:14px 16px 40px} .stats-bar{grid-template-columns:1fr} .header{flex-direction:column;gap:14px;align-items:flex-start}
    .incident-row{grid-template-columns:1fr;gap:10px} .incident-loss,.incident-time{text-align:left}
    .modal-panel{width:96%} .modal-meta-grid{grid-template-columns:1fr} .modal-header{padding:20px 22px 16px} .modal-body{padding:20px 22px 24px}
  }
  .has-tooltip { position:relative; cursor:help; }
  .has-tooltip::after { content:attr(data-tip); position:absolute; bottom:120%; left:50%; transform:translateX(-50%); background:#1a1f2e; color:#fff; padding:6px 12px; border-radius:7px; font-size:11px; white-space:nowrap; opacity:0; pointer-events:none; transition:opacity 0.2s; z-index:100; }
  .has-tooltip:hover::after { opacity:1; }
</style>
</head>
<body>
<div class="app">
  <header class="header">
    <div class="logo-area">
      <div class="logo-icon">CS</div>
      <div class="logo-text">Crypto<span>Scope</span></div>
    </div>
    <div class="header-right">
      <div style="display:flex;align-items:center;gap:10px;">
        <div class="live-dot"></div>
        <span class="header-time" id="clock">--:--:--</span>
      </div>
      <button class="refresh-btn" onclick="refreshData()">⟳ Refresh</button>
    </div>
  </header>

  <div class="stats-bar">
    <div class="stat-card"><div class="stat-label">Total Market Cap</div><div class="stat-value">$3.41T</div><div class="stat-sub up">▲ 2.3% (24h)</div></div>
