    const c=document.createElement('div');c.className='exchange-card';
    const tb=ex.type==='DEX'?'var(--purple)':'var(--blue)';
    c.innerHTML=`<div class="ex-rank">${ex.rank}</div><div class="ex-info"><div class="ex-top"><div class="ex-logo" style="background:${ex.color}18;color:${ex.color};border:1px solid ${ex.color}30">${ex.name.slice(0,2)}</div><span class="ex-name">${ex.name}</span><span class="ex-type" style="color:${tb}">[${ex.type}]</span></div><div class="ex-bar-container"><div class="ex-bar"><div class="spot-fill" style="width:${ex.spot}%"></div><div class="futures-fill" style="left:${ex.spot}%;width:${ex.futures}%"></div></div><div class="ex-legend"><span><span class="dot" style="background:var(--accent)"></span>Spot ${ex.spot}%</span><span><span class="dot" style="background:var(--blue)"></span>Fut ${ex.futures}%</span></div></div></div><div class="ex-vol"><div class="ex-vol-total">$${ex.totalVol}</div><div class="ex-vol-label">24h Volume</div><div class="ex-vol-breakdown">S:$${ex.spotVol} / F:$${ex.futVol}</div></div>`;
    g.appendChild(c);
  });
}

function renderEvents(){
  const g=document.getElementById('eventsGrid');g.innerHTML='';
  eventsData.forEach((e,i)=>{
    const c=document.createElement('div');c.className='event-card';c.onclick=()=>openEventModal(i);
    c.innerHTML=`<span class="tag ${e.tag}">${e.tagLabel}</span><h4>${e.title}</h4><p>${e.summary}</p><div class="event-meta"><span>🕐 ${e.time}</span><span class="source">${e.source}</span></div><span class="click-hint">▸ Click for details</span>`;
    g.appendChild(c);
  });
}

function renderIncidents(){
  const l=document.getElementById('incidentsList');l.innerHTML='';
  incidentsData.forEach((inc,i)=>{
    const r=document.createElement('div');r.className='incident-row';r.onclick=()=>openIncidentModal(i);
    r.innerHTML=`<span class="severity ${inc.severity}">${inc.severity}</span><div class="incident-info"><h5>${inc.title}</h5><p>${inc.desc}</p></div><div class="incident-loss">${inc.loss}</div><div class="incident-chain">${inc.chain}</div><div class="incident-time">${inc.time}</div><span class="click-hint2">▸ Details</span>`;
    l.appendChild(r);
  });
}

// ── Event Modal ──
function openEventModal(idx){
  const e=eventsData[idx],d=e.detail,m=document.getElementById('eventModal');
  document.getElementById('modalTag').className='tag '+e.tag;
  document.getElementById('modalTag').textContent=e.tagLabel;
  document.getElementById('modalTitle').textContent=e.title;
  const lm={price:'Price Impact',vol:'Volume Change',liq:'Liquidation/Inflow',sentiment:'Sentiment'};
  const impH=Object.keys(d.impact).map(k=>`<div class="impact-item"><div class="impact-val ${d.impactDir[k]||''}">${d.impact[k]}</div><div class="impact-label">${lm[k]}</div></div>`).join('');
  document.getElementById('modalBody').innerHTML=`
    <div class="modal-section"><div class="modal-section-title">Overview</div><div class="modal-text">${d.overview}</div></div>
    <div class="modal-section"><div class="modal-section-title">Key Metrics</div><div class="modal-impact">${impH}</div></div>
    <div class="modal-section"><div class="modal-section-title">Detailed Analysis</div><div class="modal-text">${d.analysis.replace(/\n/g,'<br>')}</div></div>
    <div class="modal-section"><div class="modal-section-title">Timeline</div><div class="modal-timeline">${d.timeline.map(t=>`<div class="timeline-item green"><div class="tl-time">${t.time}</div><div class="tl-text">${t.text}</div></div>`).join('')}</div></div>
    <div class="modal-section"><div class="modal-section-title">Official Sources</div><div class="modal-text">${d.official}</div></div>
    <div class="modal-section"><div class="modal-section-title">Related Assets</div><div class="modal-tags">${d.assets.map(a=>`<span class="modal-asset-tag">${a}</span>`).join('')}</div></div>
    <div class="modal-section"><div class="modal-section-title">Metadata</div><div class="modal-meta-grid"><div class="modal-meta-item"><div class="label">Source</div><div class="value" style="color:var(--accent)">${e.source}</div></div><div class="modal-meta-item"><div class="label">Reported</div><div class="value">${e.time}</div></div><div class="modal-meta-item"><div class="label">Category</div><div class="value">${e.tagLabel}</div></div></div></div>`;
  requestAnimationFrame(()=>m.classList.add('visible'));
  document.body.style.overflow='hidden';
}

// ── Incident Modal ──
function openIncidentModal(idx){
  const inc=incidentsData[idx],d=inc.detail,m=document.getElementById('incidentModal');
  const sevEl=document.getElementById('incModalSev');
  sevEl.className='severity '+inc.severity;sevEl.textContent=inc.severity.toUpperCase();
  document.getElementById('incModalTitle').textContent=inc.title;

  const statusMap={ongoing:'Ongoing',mitigated:'Mitigated',resolved:'Resolved'};

  document.getElementById('incModalBody').innerHTML=`
    <div class="modal-section"><div class="modal-section-title red">Overview</div><div class="modal-text">${d.overview}</div></div>

    <div class="modal-section"><div class="modal-section-title">Incident Summary</div><div class="modal-meta-grid">
      <div class="modal-meta-item"><div class="label">Total Loss</div><div class="value" style="color:var(--red)">${inc.loss}</div></div>
      <div class="modal-meta-item"><div class="label">Chain</div><div class="value">${inc.chain}</div></div>
      <div class="modal-meta-item"><div class="label">Status</div><div class="value"><span class="status-badge ${d.status}">${statusMap[d.status]}</span></div></div>
      <div class="modal-meta-item"><div class="label">Severity</div><div class="value">${inc.severity.toUpperCase()}</div></div>
      <div class="modal-meta-item"><div class="label">Attack Vector</div><div class="value" style="font-size:13px">${d.attackVector}</div></div>
      <div class="modal-meta-item"><div class="label">Funds Recovered</div><div class="value" style="font-size:13px;color:var(--accent)">${d.fundsRecovered}</div></div>
    </div></div>

    <div class="modal-section"><div class="modal-section-title orange">Root Cause Analysis</div><ul class="cause-list">${d.rootCause.map(c=>`<li>${c}</li>`).join('')}</ul></div>

    <div class="modal-section"><div class="modal-section-title red">Attack Timeline</div><div class="modal-timeline">${d.timeline.map(t=>`<div class="timeline-item ${t.type==='red'?'red-dot':'green'}"><div class="tl-time">${t.time}</div><div class="tl-text">${t.text}</div></div>`).join('')}</div></div>

    <div class="modal-section"><div class="modal-section-title red">Loss Breakdown</div><table class="loss-breakdown-table"><thead><tr><th>Address / Group</th><th>Amount</th><th>Tokens</th></tr></thead><tbody>${d.losses.map(l=>`<tr><td>${l.address}</td><td class="loss-amt">${l.amount}</td><td>${l.tokens}</td></tr>`).join('')}</tbody></table></div>

    <div class="modal-section"><div class="modal-section-title blue">Affected Assets</div><div class="modal-tags">${d.affectedAssets.map(a=>`<span class="modal-asset-tag">${a}</span>`).join('')}</div></div>

    <div class="modal-section"><div class="modal-section-title">Remediation & Actions Taken</div><ul class="remediation-list">${d.remediation.map(r=>`<li>${r}</li>`).join('')}</ul></div>

    <div class="modal-section"><div class="modal-section-title">Report & Legal</div><div class="modal-meta-grid">
      <div class="modal-meta-item"><div class="label">Law Enforcement</div><div class="value" style="font-size:13px">${d.policeReport}</div></div>
      <div class="modal-meta-item"><div class="label">Reported</div><div class="value">${inc.time}</div></div>
      <div class="modal-meta-item"><div class="label">Attacked Chain</div><div class="value">${inc.chain}</div></div>
    </div></div>`;

  requestAnimationFrame(()=>m.classList.add('visible'));
  document.body.style.overflow='hidden';
}

function closeModal(ev,id){
  if(ev&&ev.target!==ev.currentTarget)return;
  document.getElementById(id).classList.remove('visible');
  document.body.style.overflow='';
}
document.addEventListener('keydown',e=>{
  if(e.key==='Escape'){closeModal(null,'eventModal');closeModal(null,'incidentModal');}
});

// ── Tab/Search/Sort/Refresh ──
function switchTab(btn,tab){document.querySelectorAll('.tab-btn').forEach(b=>b.classList.remove('active'));btn.classList.add('active');renderTable(tab==='all'?cryptoData:cryptoData.filter(d=>d.tags.includes(tab)));}
function filterTable(q){q=q.toLowerCase();document.querySelectorAll('#tableBody tr').forEach(r=>r.style.display=r.textContent.toLowerCase().includes(q)?'':'none');}
let sortDir={};
function sortTable(ci){const dir=sortDir[ci]==='asc'?'desc':'asc';sortDir[ci]=dir;const tb=document.getElementById('tableBody'),rows=Array.from(tb.querySelectorAll('tr'));rows.sort((a,b)=>{let aV=a.cells[ci].textContent.trim(),bV=b.cells[ci].textContent.trim();const aN=parseFloat(aV.replace(/[$,%+]/g,'')),bN=parseFloat(bV.replace(/[$,%+]/g,''));if(!isNaN(aN)&&!isNaN(bN))return dir==='asc'?aN-bN:bN-aN;return dir==='asc'?aV.localeCompare(bV):bV.localeCompare(aV);});rows.forEach(r=>tb.appendChild(r));}
function refreshData(){cryptoData.forEach(d=>{const delta=(Math.random()-0.48)*0.5;d.price*=(1+delta/100);d.change24+=delta*0.3;});renderTable(cryptoData);const btn=document.querySelector('.refresh-btn');btn.textContent='⟳ Updating...';btn.style.pointerEvents='none';setTimeout(()=>{btn.textContent='⟳ Refresh';btn.style.pointerEvents='';},1000);}
setInterval(refreshData,30000);

// ── Init ──
renderTable(cryptoData);renderExchanges();renderEvents();renderIncidents();
</script>
</body>
</html>
